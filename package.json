{
  "name": "n8n-nodes-trino",
  "version": "1.0.3",
  "description": "A n8n node that allows you to query your Trino instance",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "author": {
    "name": "Dmsrdnv",
    "email": "dmsrdnv@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dmsrdnv/n8n-nodes-trino.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TrinoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Trino/Trino.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.82.0",
    "prettier": "^2.7.1",
    "typescript": "~4.8.4"
  },
  "dependencies": {
    "@trinodb/trino-js-client": "^0.3.2"
  }
}
